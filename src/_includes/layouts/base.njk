<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and page.url != "/" %}{{ title }} · {% endif %}{{ site.titulo }}</title>
  <meta name="description" content="{{ description or site.descripcion }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="mh-utility">
    <div class="mh-utility__inner">
      <div class="mh-utility__links">
        {%- for u in site.utilidad %}
        <a href="{{ u.href }}">{{ u.label }}</a>
        {%- endfor %}
      </div>
      <div class="mh-utility__meta">
        <span class="mh-utility__phone">{{ site.telefono }}</span>
        <div class="mh-utility__social">
          {%- for r in site.redes %}
          <a href="{{ r.href }}" aria-label="{{ r.icono | replace('fa-brands fa-', '') }}"><i class="{{ r.icono }}"></i></a>
          {%- endfor %}
        </div>
      </div>
    </div>
  </div>

  <header class="mh-nav">
    <div class="mh-nav__inner">
      <a class="mh-logo" href="/">
        <span class="mh-logo__mark" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
        </span>
        <span class="mh-logo__text">
          <span class="mh-logo__title">MÓNICA HERRERA</span>
          <span class="mh-logo__sub">/ SECCIÓN IA</span>
        </span>
      </a>
      <nav class="mh-nav__links" aria-label="Principal">
        <ul>
          {%- for entry in collections.all | eleventyNavigation %}
          {%- set activo = (entry.url == page.url) or (entry.url != "/" and page.url.startsWith(entry.url)) %}
          <li{% if activo %} class="activo"{% endif %}><a href="{{ entry.url }}">{{ entry.title }}</a></li>
          {%- endfor %}
        </ul>
        <button type="button" class="mh-nav__search" aria-label="Buscar"><i class="fa-solid fa-magnifying-glass"></i></button>
        <span class="mh-nav__divider" aria-hidden="true">|</span>
        <span class="mh-nav__lang">ENG</span>
      </nav>
    </div>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="mh-footer">
    <div class="mh-footer__top">
      <div class="mh-footer__brand">
        <div class="mh-footer__logo">
          <span class="mh-footer__diamond" aria-hidden="true"></span>
          <span>MÓNICA HERRERA</span>
        </div>
        <p>{{ site.descripcion }}.</p>
      </div>
      <div class="mh-footer__col">
        <div class="mh-footer__heading">Explorá</div>
        <a href="/manifiesto/">Manifiesto</a>
        <a href="/cuadernos/">Cuadernos</a>
        <a href="/biblioteca/">Biblioteca</a>
        <a href="/antecedentes/">Antecedentes</a>
      </div>
      <div class="mh-footer__col">
        <div class="mh-footer__heading">Más</div>
        <a href="/multimedia/">Multimedia</a>
        <a href="/equipo/">Equipo</a>
        <a href="/antecedentes/noticias/">Noticias</a>
      </div>
      <div class="mh-footer__col">
        <div class="mh-footer__heading">Contacto</div>
        <p class="mh-footer__contact">{{ site.telefono }}<br>ia.monicaherrera.edu.sv</p>
        <div class="mh-footer__social">
          {%- for r in site.redes %}
          <a href="{{ r.href }}" aria-label="{{ r.icono | replace('fa-brands fa-', '') }}"><i class="{{ r.icono }}"></i></a>
          {%- endfor %}
        </div>
      </div>
    </div>
    <div class="mh-footer__bottom">
      <span>© {{ anio }} Escuela de Comunicación Mónica Herrera</span>
      <span>ia.monicaherrera.edu.sv</span>
    </div>
  </footer>

  <a class="mh-whatsapp" href="{{ site.whatsapp }}" target="_blank" rel="noopener" aria-label="Escribinos por WhatsApp">
    <i class="fa-brands fa-whatsapp"></i>
  </a>
</body>
</html>
