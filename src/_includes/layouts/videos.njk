---
layout: layouts/base.njk
---
<article class="pagina">
  <header class="pagina-header">
    <h1>{{ title }}</h1>
  </header>
  {{ content | safe }}
  <div class="videos">
    {%- for item in collections[coleccion] | reverse %}
    <section class="video">
      <h2>{{ item.data.title }}</h2>
      <div class="video-embed">
        <iframe src="https://www.youtube-nocookie.com/embed/{{ item.data.youtubeId }}" title="{{ item.data.title }}" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
      </div>
      <div class="video-nota">{{ item.templateContent | safe }}</div>
    </section>
    {%- endfor %}
  </div>
</article>
